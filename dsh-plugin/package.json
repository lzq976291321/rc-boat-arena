{
  "name": "dsh-rc-boat-arena",
  "version": "1.0.0",
  "private": true,
  "description": "RC Boat Arena 的 DSH Web 面板插件（host 半静态托管，浏览器半提供会话头部入口）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
